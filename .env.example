# Copy this file to .env.local and fill in the values

# API base URL (include /api prefix)
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Production (set this in Vercel dashboard, not here):
# NEXT_PUBLIC_API_URL=https://api.aminihq.com/api

# Canonical origin, no trailing slash. Used for canonical tags, Open Graph
# URLs, JSON-LD, sitemap.xml and robots.txt. Defaults to https://amini.ng.
# Set this on preview deployments so they do not claim the production URL.
# NEXT_PUBLIC_SITE_URL=https://amini.ng
