{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Amini design tokens. Single brand hue, anchored on the Amini primary #02534D. Mirrors src/styles/variables.css (primitive) and src/styles/theme.css (semantic).",
  "brand": {
    "primary": {
      "$value": "#02534D",
      "$type": "color",
      "$description": "The Amini primary. The only brand hue in the system."
    }
  },
  "primitive": {
    "brand": {
      "50":  { "$value": "#EDFAF9", "$type": "color" },
      "100": { "$value": "#D0F5F3", "$type": "color" },
      "200": { "$value": "#A3EBE8", "$type": "color" },
      "300": { "$value": "#6EDBD6", "$type": "color" },
      "400": { "$value": "#3ABFBA", "$type": "color" },
      "500": { "$value": "#1E9E99", "$type": "color" },
      "550": { "$value": "#0D7671", "$type": "color" },
      "600": { "$value": "#02534D", "$type": "color", "$description": "Amini primary" },
      "700": { "$value": "#014742", "$type": "color" },
      "800": { "$value": "#013B36", "$type": "color" },
      "850": { "$value": "#0E322F", "$type": "color" },
      "900": { "$value": "#012F2B", "$type": "color" },
      "950": { "$value": "#011917", "$type": "color" }
    },
    "neutral": {
      "0":   { "$value": "#FFFFFF", "$type": "color" },
      "25":  { "$value": "#F9FBFB", "$type": "color" },
      "50":  { "$value": "#F4F7F7", "$type": "color" },
      "100": { "$value": "#EAF0EF", "$type": "color" },
      "200": { "$value": "#DDE6E5", "$type": "color" },
      "300": { "$value": "#C6D4D2", "$type": "color" },
      "400": { "$value": "#A6BFBC", "$type": "color" },
      "500": { "$value": "#89A29F", "$type": "color" },
      "550": { "$value": "#708B88", "$type": "color" },
      "600": { "$value": "#5A716E", "$type": "color" },
      "700": { "$value": "#455D5A", "$type": "color" },
      "800": { "$value": "#2C524E", "$type": "color" },
      "850": { "$value": "#1E3D3A", "$type": "color" },
      "900": { "$value": "#0C2523", "$type": "color" },
      "925": { "$value": "#0A1F1D", "$type": "color" },
      "950": { "$value": "#071B19", "$type": "color" },
      "975": { "$value": "#041312", "$type": "color" }
    },
    "green": {
      "50":  { "$value": "#E6F4EC", "$type": "color" },
      "300": { "$value": "#4ECB8E", "$type": "color" },
      "600": { "$value": "#0F7A4A", "$type": "color" },
      "900": { "$value": "#0D3527", "$type": "color" }
    },
    "amber": {
      "50":  { "$value": "#FBF0E0", "$type": "color" },
      "300": { "$value": "#E5A33D", "$type": "color" },
      "600": { "$value": "#9A5B00", "$type": "color" },
      "900": { "$value": "#3A2A0C", "$type": "color" }
    },
    "red": {
      "50":  { "$value": "#FBEAE8", "$type": "color" },
      "300": { "$value": "#F08379", "$type": "color" },
      "600": { "$value": "#B4302A", "$type": "color" },
      "900": { "$value": "#3A1A17", "$type": "color" }
    }
  },
  "semantic": {
    "light": {
      "canvas-1":     { "$value": "{primitive.neutral.0}",   "$type": "color", "$description": "Page background, large surfaces" },
      "canvas-2":     { "$value": "{primitive.neutral.50}",  "$type": "color", "$description": "Lifted surfaces, cards" },
      "canvas-3":     { "$value": "{primitive.neutral.100}", "$type": "color", "$description": "Inset wells, depressed states" },
      "ink-1":        { "$value": "{primitive.neutral.925}", "$type": "color", "$description": "Primary body text" },
      "ink-2":        { "$value": "{primitive.neutral.700}", "$type": "color", "$description": "Secondary text, labels" },
      "ink-3":        { "$value": "{primitive.neutral.600}", "$type": "color", "$description": "Tertiary text, hints" },
      "accent-1":     { "$value": "{primitive.brand.600}",   "$type": "color", "$description": "Primary brand accent" },
      "accent-2":     { "$value": "{primitive.brand.550}",   "$type": "color", "$description": "Secondary accent" },
      "accent-hover": { "$value": "{primitive.brand.700}",   "$type": "color" },
      "accent-surface": { "$value": "{primitive.brand.50}",  "$type": "color" },
      "on-accent":    { "$value": "{primitive.neutral.0}",   "$type": "color" },
      "line-1":       { "$value": "{primitive.neutral.200}", "$type": "color" },
      "line-2":       { "$value": "{primitive.neutral.300}", "$type": "color" },
      "line-3":       { "$value": "{primitive.neutral.550}", "$type": "color" },
      "state-ok":     { "$value": "{primitive.green.600}",   "$type": "color", "$description": "Success, confirmations" },
      "state-warn":   { "$value": "{primitive.amber.600}",   "$type": "color", "$description": "Warnings" },
      "state-err":    { "$value": "{primitive.red.600}",     "$type": "color", "$description": "Errors, destructive actions" },
      "state-ok-surface":   { "$value": "{primitive.green.50}", "$type": "color" },
      "state-warn-surface": { "$value": "{primitive.amber.50}", "$type": "color" },
      "state-err-surface":  { "$value": "{primitive.red.50}",   "$type": "color" }
    },
    "dark": {
      "canvas-1":     { "$value": "{primitive.neutral.950}", "$type": "color" },
      "canvas-2":     { "$value": "{primitive.neutral.900}", "$type": "color" },
      "canvas-3":     { "$value": "{primitive.neutral.975}", "$type": "color" },
      "ink-1":        { "$value": "{primitive.neutral.25}",  "$type": "color" },
      "ink-2":        { "$value": "{primitive.neutral.400}", "$type": "color" },
      "ink-3":        { "$value": "{primitive.neutral.500}", "$type": "color" },
      "accent-1":     { "$value": "{primitive.brand.300}",   "$type": "color" },
      "accent-2":     { "$value": "{primitive.brand.400}",   "$type": "color" },
      "accent-hover": { "$value": "{primitive.brand.200}",   "$type": "color" },
      "accent-surface": { "$value": "{primitive.brand.850}", "$type": "color" },
      "on-accent":    { "$value": "{primitive.neutral.950}", "$type": "color" },
      "line-1":       { "$value": "{primitive.neutral.850}", "$type": "color" },
      "line-2":       { "$value": "{primitive.neutral.800}", "$type": "color" },
      "line-3":       { "$value": "{primitive.neutral.550}", "$type": "color" },
      "state-ok":     { "$value": "{primitive.green.300}",   "$type": "color" },
      "state-warn":   { "$value": "{primitive.amber.300}",   "$type": "color" },
      "state-err":    { "$value": "{primitive.red.300}",     "$type": "color" },
      "state-ok-surface":   { "$value": "{primitive.green.900}", "$type": "color" },
      "state-warn-surface": { "$value": "{primitive.amber.900}", "$type": "color" },
      "state-err-surface":  { "$value": "{primitive.red.900}",   "$type": "color" }
    }
  },
  "typography": {
    "family": {
      "display": { "$value": "Geist Sans", "$type": "fontFamily" },
      "body":    { "$value": "Geist Sans", "$type": "fontFamily" },
      "mono":    { "$value": "Geist Mono", "$type": "fontFamily" }
    },
    "display": {
      "xs": { "$value": { "fontSize": "32px", "lineHeight": "1.15", "letterSpacing": "-0.018em", "fontWeight": 700 }, "$type": "typography" },
      "sm": { "$value": { "fontSize": "40px", "lineHeight": "1.12", "letterSpacing": "-0.020em", "fontWeight": 700 }, "$type": "typography" },
      "md": { "$value": { "fontSize": "48px", "lineHeight": "1.08", "letterSpacing": "-0.022em", "fontWeight": 700 }, "$type": "typography" },
      "lg": { "$value": { "fontSize": "64px", "lineHeight": "1.05", "letterSpacing": "-0.024em", "fontWeight": 700 }, "$type": "typography" },
      "xl": { "$value": { "fontSize": "80px", "lineHeight": "1.02", "letterSpacing": "-0.028em", "fontWeight": 700 }, "$type": "typography" }
    },
    "body": {
      "sm": { "$value": { "fontSize": "14px", "lineHeight": "1.6",  "letterSpacing": "0em" }, "$type": "typography" },
      "md": { "$value": { "fontSize": "16px", "lineHeight": "1.65", "letterSpacing": "0em" }, "$type": "typography" },
      "lg": { "$value": { "fontSize": "18px", "lineHeight": "1.7",  "letterSpacing": "0em" }, "$type": "typography" }
    },
    "mono": {
      "sm": { "$value": { "fontSize": "12px", "lineHeight": "1.5", "letterSpacing": "0em", "fontVariantNumeric": "tabular-nums" }, "$type": "typography" },
      "md": { "$value": { "fontSize": "14px", "lineHeight": "1.5", "letterSpacing": "0em", "fontVariantNumeric": "tabular-nums" }, "$type": "typography" }
    }
  },
  "space": {
    "$description": "Base unit 4px. This is the complete scale.",
    "1":  { "$value": "4px",   "$type": "dimension" },
    "2":  { "$value": "8px",   "$type": "dimension" },
    "3":  { "$value": "12px",  "$type": "dimension" },
    "4":  { "$value": "16px",  "$type": "dimension" },
    "5":  { "$value": "24px",  "$type": "dimension" },
    "6":  { "$value": "32px",  "$type": "dimension" },
    "7":  { "$value": "48px",  "$type": "dimension" },
    "8":  { "$value": "64px",  "$type": "dimension" },
    "9":  { "$value": "96px",  "$type": "dimension" },
    "10": { "$value": "128px", "$type": "dimension" }
  },
  "radius": {
    "sm":   { "$value": "4px",    "$type": "dimension" },
    "md":   { "$value": "8px",    "$type": "dimension" },
    "lg":   { "$value": "12px",   "$type": "dimension" },
    "xl":   { "$value": "20px",   "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "elevation": {
    "0": { "$value": "none", "$type": "shadow" },
    "1": { "$value": "0 1px 2px rgba(2,83,77,0.06)", "$type": "shadow" },
    "2": { "$value": "0 2px 4px rgba(2,83,77,0.06), 0 8px 24px rgba(2,83,77,0.06)", "$type": "shadow" },
    "3": { "$value": "0 4px 8px rgba(2,83,77,0.08), 0 16px 48px rgba(2,83,77,0.10)", "$type": "shadow" },
    "inset": { "$value": "inset 0 1px 2px rgba(2,83,77,0.07)", "$type": "shadow" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "base": { "$value": "220ms", "$type": "duration" },
      "slow": { "$value": "400ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)",     "$type": "cubicBezier" },
      "out":      { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier" }
    }
  }
}
